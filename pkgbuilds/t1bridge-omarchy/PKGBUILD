pkgname=t1bridge-omarchy
pkgver=0.2.1
pkgrel=1
pkgdesc='Optional Omarchy desktop integration for T1Bridge'
arch=('any')
license=('MIT')
depends=('brightnessctl' 'coreutils' 'iio-sensor-proxy' 'bash' 'gawk' 'jq' 'libpulse' 'omarchy>=4.0.1' 'systemd' 't1bridge>=0.1.0')
makedepends=('make')
checkdepends=('diffutils')
source=("$pkgname-$pkgver.tar.gz::https://linux.standardagents.ai/arch/standardagents/x86_64/$pkgname-$pkgver.tar.gz")
sha256sums=('bbd4b4a6f923cc308fbdeb6703c0fb71858d68140fa44e10cec217611c1b0e90')

check() {
  make -C "$srcdir/$pkgname-$pkgver" check
}

package() {
  make -C "$srcdir/$pkgname-$pkgver" install DESTDIR="$pkgdir"
}
